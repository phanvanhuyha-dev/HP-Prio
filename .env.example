# === Vercel Postgres (tự động điền khi anh tạo Postgres DB trong dashboard Vercel > Storage) ===
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# === Google OAuth (Google Cloud Console > APIs & Services > Credentials) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Google DUY NHẤT được phép đăng nhập vào app này
OWNER_EMAIL=ha.phan@vidu.com

# === NextAuth ===
# Random string bất kỳ, tạo bằng lệnh: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# === Gemini API (Google AI Studio: https://aistudio.google.com/app/apikey) ===
GEMINI_API_KEY=

# ĐỂ TRỐNG. App tự chọn model dùng được, không ghim phiên bản nào.
# Google liên tục ngừng cấp model cũ, ghim tên cụ thể là hỏng app sau vài tháng.
# Chỉ điền khi cần ép dùng đúng một model nào đó.
GEMINI_MODEL=

# === Web Push (tạo bằng lệnh: npx web-push generate-vapid-keys) ===
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# === Cron bảo mật (random string bất kỳ, tự đặt) ===
CRON_SECRET=
